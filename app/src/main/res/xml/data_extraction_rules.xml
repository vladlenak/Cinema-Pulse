<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Room database contains saved favorites, watched movies, and offline cache. -->
        <include
            domain="database"
            path="cinema_pulse.db" />
        <include
            domain="database"
            path="cinema_pulse.db-shm" />
        <include
            domain="database"
            path="cinema_pulse.db-wal" />
        <include
            domain="database"
            path="cinema_pulse.db-journal" />
    </cloud-backup>

    <device-transfer>
        <include
            domain="database"
            path="cinema_pulse.db" />
        <include
            domain="database"
            path="cinema_pulse.db-shm" />
        <include
            domain="database"
            path="cinema_pulse.db-wal" />
        <include
            domain="database"
            path="cinema_pulse.db-journal" />
    </device-transfer>
</data-extraction-rules>
