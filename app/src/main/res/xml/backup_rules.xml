<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Room database contains saved favorites, watched movies, and offline cache. -->
    <include
        domain="database"
        path="cinema_pulse.db"
        requireFlags="clientSideEncryption" />
    <include
        domain="database"
        path="cinema_pulse.db-shm"
        requireFlags="clientSideEncryption" />
    <include
        domain="database"
        path="cinema_pulse.db-wal"
        requireFlags="clientSideEncryption" />
    <include
        domain="database"
        path="cinema_pulse.db-journal"
        requireFlags="clientSideEncryption" />
</full-backup-content>
